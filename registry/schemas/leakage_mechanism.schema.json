{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeg-benchmark-registry.org/schemas/leakage_mechanism.schema.json",
  "title": "EEG Leakage Mechanism Specification Schema",
  "type": "object",
  "required": ["leakage_id", "name", "category", "clean_comparator", "failure_mechanism"],
  "properties": {
    "leakage_id": {
      "type": "string",
      "enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7"]
    },
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "spatial_filter_leakage",
        "artifact_subspace_leakage",
        "normalization_leakage",
        "feature_selection_leakage",
        "hyperparameter_optimization_leakage",
        "temporal_segmentation_leakage",
        "data_augmentation_leakage"
      ]
    },
    "clean_comparator": { "type": "string" },
    "failure_mechanism": { "type": "string" },
    "mathematical_definition": { "type": "string" },
    "expected_bias_direction": {
      "type": "string",
      "enum": ["positive_inflation", "negative_deflation", "unconstrained_variance"]
    }
  }
}
