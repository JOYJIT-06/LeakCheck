{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeg-benchmark-registry.org/schemas/dataset.schema.json",
  "title": "EEG Dataset Metadata Schema",
  "type": "object",
  "required": ["dataset_id", "name", "sampling_rate_hz", "channel_count", "license"],
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "doi": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "sampling_rate_hz": {
      "type": "number",
      "minimum": 1.0
    },
    "channel_count": {
      "type": "integer",
      "minimum": 1
    },
    "montage": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "participant_count": {
      "type": "integer",
      "minimum": 1
    },
    "sessions_per_participant": {
      "type": "integer",
      "minimum": 1
    },
    "runs_per_session": {
      "type": "integer",
      "minimum": 1
    }
  }
}
